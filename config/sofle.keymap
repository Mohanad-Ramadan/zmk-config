#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Override ZMK's built-in &soft_off to require a 1.5s hold.
 * Wake from soft-off: press the reset button on each half. */

&soft_off { hold-time-ms = <1500>; };

/ {
    combos {
        compatible = "zmk,combos";
        super_screenshot {
            bindings = <&kp LG(LS(N5))>;
            key-positions = <43 42>;
        };
        go-to-gaming {
            bindings = <&to 5>;
            key-positions = <28 27 26>;
        };
        combo_30823645 {
            bindings = <&kp BSPC>;
            key-positions = <28 31>;
        };
    };
    behaviors {
        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ENCODER_SCROLL";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
        mouse_movement: mouse_movement {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "MOUSE_MOVEMENT";
            #sensor-binding-cells = <2>;
            bindings = <&mmv>, <&mmv>;
        };
    };
    macros {
        arrow_string_R: first_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp MINUS &kp GT>;
            label = "FIRST_MACRO";
        };
        knife_weapon_switch: knife_weapon_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_1>;
            label = "KNIFE_WEAPON_SWITCH";
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "BAS";
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
                &kp BSPC &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P
                &kp BSPC &kp LCTRL &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L
                &kp SEMI &kp ENTER &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp C_VOICE_COMMAND
                &kp C_PP &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT &mo 3 &kp LALT
                &kp LGUI &mo 1 &kp RCTRL &kp ENTER &mo 2 &kp SPACE &kp RGUI &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>, <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
        lower_layer {
            display-name = "LOW";
            bindings = <
                &kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F11
                &trans &kp GRAVE &kp N6 &kp N7 &kp N8 &kp FSLH &kp FSLH &kp BSLH &kp LBKT
                &kp RBKT &kp C &kp F &kp DEL &trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5
                &arrow_string_R &kp N9 &kp N0 &kp P &kp M &kp SQT &trans &trans &trans &kp LBKT
                &kp RBKT &kp COMMA &trans &kp K_MUTE &kp DOT &kp MINUS &kp EQUAL &kp EQUAL
                &trans &trans &trans &trans &trans &trans &trans &trans &kp GRAVE &trans &trans
                &trans
            >;
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)>, <&inc_dec_kp LG(LS(RIGHT_BRACKET)) LG(LS(LEFT_BRACKET))>;
        };
        raise_layer {
            display-name = "RAI";
            bindings = <
                &trans &trans &trans &trans &trans &trans &sys_reset &trans &studio_unlock
                &trans &trans &trans &trans &kp LBKT &kp RBKT &kp K_CMENU &kp BSPC &kp MINUS
                &kp EQUAL &kp BSPC &kp UP &trans &kp N0 &kp BSPC &trans &kp LSHFT &kp LCTRL
                &kp LALT &kp LGUI &kp BSPC &kp DEL &kp LEFT &kp DOWN &kp RIGHT &trans &kp SQT
                &trans &kp K_UNDO &kp X &kp C &kp V &trans &kp C_VOICE_COMMAND &trans &trans
                &kp BSPC &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)>;
        };
        num_pad {
            bindings = <
                &soft_off &bt BT_NXT &kp K_LOCK &kp K_SLEEP &kp K_POWER &trans &bt BT_CLR
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_DISC 0 &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &kp N7 &kp N8 &kp N9 &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &kp N4 &kp N5 &kp N6 &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &kp N1 &kp N2 &kp N3
                &trans &trans &trans &msc SCRL_DOWN &msc SCRL_UP &trans &tog 4 &trans &trans
                &trans &kp DOT &kp N0
            >;
            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>, <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };
        Mouse {
            bindings = <
                &to 0 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &msc SCRL_UP
                &mmv MOVE_UP &msc SCRL_DOWN &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &msc SCRL_LEFT &mkp MCLK
                &msc SCRL_RIGHT &trans &trans &trans &trans &trans &trans &mkp LCLK &mkp RCLK
                &trans &trans &trans &trans
            >;
            sensor-bindings = <&mouse_movement MOVE_Y(-100) MOVE_Y(100)>, <&mouse_movement MOVE_X(100) MOVE_X(-100)>;
        };
        Gaming-windows {
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &trans &trans &trans &trans &trans
                &trans &kp TAB &kp X &kp Q &kp W &kp E &kp R &trans &trans &trans &trans &trans
                &trans &kp LSHFT &kp LCTRL &kp A &kp S &kp D &kp B &trans &trans &trans &trans
                &trans &trans &kp M &kp C &kp V &kp ENTER &kp Z &kp M &to 0 &trans &trans &trans
                &trans &trans &trans &trans &kp ENTER &kp RGUI &kp SPACE &kp LSHFT &kp F &trans
                &trans &trans &trans &trans
            >;
        };
        layer_6 {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
            >;
        };
    };
};
