#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Override ZMK's built-in &soft_off to require a 1.5s hold.
 * Kept for manual flashing; num_pad layer now aligns to RMK (No),
 * so soft_off is only available via this behavior if re-added. */

&soft_off { hold-time-ms = <1500>; };

/ {
    combos {
        compatible = "zmk,combos";
        /* RMK: F+J -> WM(Kc5, LShift|LG) = screenshot (keyboard.toml:275)
         * physical positions: F=RC(2,4)=28, J=RC(2,7)=31 */
        combo_screenshot {
            bindings = <&kp LG(LS(N5))>;
            key-positions = <28 31>;
        };
        /* RMK: S+D+F -> TO(5) gaming (keyboard.toml:277) */
        go_to_gaming {
            bindings = <&to 5>;
            key-positions = <28 27 26>;
        };
    };
    behaviors {
        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ENCODER_SCROLL";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };
        mouse_movement: mouse_movement {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "MOUSE_MOVEMENT";
            #sensor-binding-cells = <2>;
            bindings = <&mmv>, <&mmv>;
        };
    };
    macros {
        /* RMK Macro(0): "->"  keyboard.toml:230-236 */
        arrow_string_R: arrow_string_R {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp MINUS>, <&macro_press &kp LSHFT>, <&macro_tap &kp DOT>, <&macro_release &kp LSHFT>;
            label = "ARROW_STRING_R";
        };
        /* RMK Macro(1): "()" + cursor left  keyboard.toml:239-246 */
        macro_paren: macro_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp N9>, <&macro_tap &kp N0>, <&macro_release &kp LSHFT>, <&macro_tap &kp LEFT>;
            label = "MACRO_PAREN";
        };
        /* RMK Macro(2): "{}"  keyboard.toml:249-256 */
        macro_brace: macro_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT>, <&macro_tap &kp LBKT>, <&macro_tap &kp RBKT>, <&macro_release &kp LSHFT>, <&macro_tap &kp LEFT>;
            label = "MACRO_BRACE";
        };
        /* RMK Macro(3): "[]"  keyboard.toml:259-264 */
        macro_bracket: macro_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LBKT>, <&macro_tap &kp RBKT>, <&macro_tap &kp LEFT>;
            label = "MACRO_BRACKET";
        };
    };
    keymap {
        compatible = "zmk,keymap";
        /* Layer 0 BAS  keyboard.toml:120-127  -> 60 keys */
        default_layer {
            display-name = "BAS";
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
                &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp ENTER
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp LC(LS(LA(LG(S)))) &kp C_PP &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &mo 3 &kp LALT &kp LGUI &mo 1 &kp RCTRL &kp ENTER &mo 2 &kp SPACE &kp LGUI &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>, <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
        /* Layer 1 LOW  keyboard.toml:139-147  entropy-synced 2026-09-01 */
        lower_layer {
            display-name = "LOW";
            bindings = <
                &kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F11 &trans
                &kp LC(GRAVE) &kp CARET &kp AMPS &kp ASTRK &kp QMARK &kp BSLH &kp FSLH &macro_bracket &kp LS(LA(F18)) &kp LC(LS(LA(LG(C)))) &kp LC(LS(LA(LG(F)))) &kp DEL
                &trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &arrow_string_R &macro_paren &macro_brace &kp LC(P) &kp LC(LS(LA(LG(M)))) &kp SQT
                &trans &trans &trans &kp LBRC &kp RBRC &kp LC(LA(LG(COMMA))) &kp LC(LS(LA(LG(D)))) &kp C_MUTE &kp LC(LA(LG(DOT))) &kp MINUS &kp PLUS &kp EQUAL &trans &trans
                &trans &trans &trans &trans &trans &kp LG(GRAVE) &kp LS(LG(GRAVE)) &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)>, <&inc_dec_kp LS(LG(RBKT)) LS(LG(LBKT))>;
        };
        /* Layer 2 RAI  keyboard.toml:154-162 */
        raise_layer {
            display-name = "RAI";
            bindings = <
                &trans &trans &trans &trans &trans &trans &sys_reset &bootloader &none &trans &trans &trans
                &trans &kp LG(LBKT) &kp LG(RBKT) &mkp RCLK &kp LA(BSPC) &kp LG(MINUS) &kp LG(EQUAL) &kp LA(BSPC) &kp UP &trans &kp N0 &kp BSPC
                &trans &kp LSHFT &kp LCTRL &kp LALT &kp LGUI &kp DEL &kp BSPC &kp LEFT &kp DOWN &kp RIGHT &trans &kp SQT
                &trans &kp K_UNDO &kp LG(X) &kp LG(C) &kp LG(V) &trans &trans &trans &trans &kp LG(BSPC) &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };
        /* Layer 3 num_pad  keyboard.toml:179-186  soft_off dropped -> &trans at (4,0) */
        num_pad {
            display-name = "num_pad";
            bindings = <
                &none &bt BT_NXT &none &kp K_SLEEP &kp K_POWER &trans &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &none &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &kp N7 &kp N8 &kp N9 &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &kp N4 &kp N5 &kp N6 &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp N1 &kp N2 &kp N3 &trans &trans
                &trans &msc SCRL_DOWN &msc SCRL_UP &trans &tog 4 &trans &trans &trans &kp N0 &kp DOT
            >;
            sensor-bindings = <&inc_dec_kp PAGE_UP PAGE_DOWN>, <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };
        /* Layer 4 Mouse  keyboard.toml:191-200 */
        Mouse {
            display-name = "Mouse";
            bindings = <
                &to 0 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &msc SCRL_UP &mmv MOVE_UP &msc SCRL_DOWN &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &msc SCRL_LEFT &mkp MCLK &msc SCRL_RIGHT &trans &trans
                &trans &trans &trans &trans &mkp LCLK &mkp RCLK &trans &trans &trans &trans
            >;
            sensor-bindings = <&mouse_movement MOVE_Y(-100) MOVE_Y(100)>, <&mouse_movement MOVE_X(100) MOVE_X(-100)>;
        };
        /* Layer 5 Gaming  keyboard.toml:205-212  inert encoders */
        Gaming_windows {
            display-name = "Gaming-windows";
            bindings = <
                &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &trans &trans &trans &trans &trans &trans
                &kp TAB &kp X &kp Q &kp W &kp E &kp R &trans &trans &trans &trans &trans &trans
                &kp LSHFT &kp LCTRL &kp A &kp S &kp D &kp B &trans &trans &trans &trans &trans &trans
                &kp M &kp C &kp Z &kp X &kp V &kp M &to 0 &trans &trans &trans &trans &trans &trans &trans
                &kp ENTER &kp RGUI &kp SPACE &kp LSHFT &kp N3 &trans &trans &trans &trans &trans
            >;
        };
        /* Layer 6 empty  keyboard.toml:214-223  12+12+12+14+10=60 */
        layer_6 {
            display-name = "layer_6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
